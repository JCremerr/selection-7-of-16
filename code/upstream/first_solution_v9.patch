@@ -16,6 +16,73 @@ pub trait Poset: Sized + Debug {
     /// returns a bitset of all elements less than i
     fn get_all_less_than(&self, i: u8) -> BitSet;
 
+    /// [patch] LB_best = max(ceil(log2(FG + FGdual - |C|)), KEY): a proven lower
+    /// bound on the remaining comparisons (code/analysis/LOWER_BOUNDS.txt,
+    /// Thms 2 and 4). self.i() = number of elements below the answer (k).
+    /// Requires indices to be a linear extension (lower triangular storage).
+    fn lb_best(&self) -> u32 {
+        let (c, fg, fgd, key) = self.lb_stats();
+        if c == 0 {
+            return u32::MAX; // no compatible solution: inconsistent (cannot happen)
+        }
+        let phi = fg + fgd - c;
+        let lb_phi = if phi <= 1 { 0 } else { 64 - (phi - 1).leading_zeros() };
+        lb_phi.max(key)
+    }
+
+    /// [patch] (|C|, FG, FGdual, KEY) in one pass over the down-sets of size k
+    fn lb_stats(&self) -> (u64, u64, u64, u32) {
+        let n = self.n() as usize;
+        let k = self.i() as usize;
+        let mut down = [0u16; MAX_N];
+        let mut up = [0u16; MAX_N];
+        for x in 0..n {
+            down[x] = self.get_all_less_than(x as u8).bits();
+            up[x] = self.get_all_greater_than(x as u8).bits();
+            // linear-extension order is required by the down-set DFS below
+            assert!(down[x] >> x == 0, "lb_best: index order is not a linear extension");
+        }
+        let full: u16 = if n >= 16 { u16::MAX } else { (1u16 << n) - 1 };
+        // acc = (C, FG, FGdual, KEY)
+        let mut acc = (0u64, 0u64, 0u64, 0u32);
+        #[allow(clippy::too_many_arguments)]
+        fn rec(p: usize, n: usize, k: usize, l: u16, cnt: usize, down: &[u16; MAX_N],
+               up: &[u16; MAX_N], full: u16, acc: &mut (u64, u64, u64, u32)) {
+            if cnt == k {
+                let m = full & !l;
+                let mut min_m = 0u16;
+                let mut max_l = 0u16;
+                for x in 0..n {
+                    let bx = 1u16 << x;
+                    if m & bx != 0 && down[x] & m == 0 { min_m |= bx; }
+                    if l & bx != 0 && up[x] & l == 0 { max_l |= bx; }
+                }
+                let b = min_m.count_ones() - 1;
+                acc.0 += b as u64 + 1;
+                acc.1 += 1u64 << b;
+                let mut es = min_m;
+                while es != 0 {
+                    let e = es.trailing_zeros() as usize;
+                    es &= es - 1;
+                    let rest = max_l & !down[e];
+                    let a = rest.count_ones();
+                    acc.3 = acc.3.max(a + b);
+                    if (rest as u32) >> e == 0 {
+                        acc.2 += 1u64 << a;
+                    }
+                }
+                return;
+            }
+            if p == n || n - p < k - cnt { return; }
+            if down[p] & !l == 0 {
+                rec(p + 1, n, k, l | (1u16 << p), cnt + 1, down, up, full, acc);
+            }
+            rec(p + 1, n, k, l, cnt, down, up, full, acc);
+        }
+        rec(0, n, k, 0, 0, &down, &up, full, &mut acc);
+        acc
+    }
+

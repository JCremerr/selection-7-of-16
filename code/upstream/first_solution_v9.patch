+/// [patch] load the ground-truth table (see Search::table)
+fn load_table() -> HashMap<BackwardsPoset, u8> {
+    let mut map = HashMap::new();
+    let Ok(path) = std::env::var("SELGEN_TABLE") else { return map; };
+    let maxn: u8 = std::env::var("SELGEN_TABLE_MAXN").ok().and_then(|v| v.parse().ok()).unwrap_or(12);
+    let text = std::fs::read_to_string(&path).expect("SELGEN_TABLE: cannot read");
+    let t0 = Instant::now();
+    for line in text.lines() {
+        let f: Vec<&str> = line.split('\t').collect();
+        if f.len() < 4 { continue; }
+        let Ok(n) = f[0].parse::<u8>() else { continue; };
+        if n > maxn { continue; }
+        let i1: u8 = f[1].parse().unwrap();
+        let v: u8 = f[2].parse().unwrap();
+        let mut p = FreePoset::new(n, i1 - 1);
+        for (a, h) in f[3].split(',').enumerate() {
+            let mask = u32::from_str_radix(h, 16).unwrap();
+            for b in 0..n as u32 {
+                if mask >> b & 1 == 1 {
+                    p.add_and_close(a as u8, b as u8);
+                }
+            }
+        }
+        let key = p.canonified().to_backward();
+        if let Some(old) = map.insert(key, v) {
+            assert_eq!(old, v, "SELGEN_TABLE: inconsistent values for one normal form");
+        }
+    }
+    println!("[patch] table: {} entries (n <= {}) loaded in {:.1}s", map.len(), maxn, t0.elapsed().as_secs_f64());
+    map
+}
